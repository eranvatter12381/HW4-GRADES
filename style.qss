QWidget {background-color: #f4f6f9;
    font-family: "Segoe UI", Arial;
    font-size: 14px;
    color: #2c3e50;}

QPushButton {background-color: #3498db;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;}

QPushButton:hover {background-color: #2980b9;}

QSpinBox {background-color: white;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px 8px;}

QTableWidget {background-color: white;
    border: 1px solid #dcdde1;
    gridline-color: #ecf0f1;}

QHeaderView::section {background-color: #34495e;
    color: white;
    padding: 6px;
    font-weight: bold;
    border: none;}